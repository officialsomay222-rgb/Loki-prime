# --- Netlify / Production / AI Studio Environment Variables ---

# Google Gemini API Key (Enables Vision, Search Grounding, Thinking & Gemini Models)
GEMINI_API_KEY=
GOOGLE_AI_KEY=
VITE_GEMINI_API_KEY=

# Groq API Key (Enables Ultra-Fast Llama Models & Whisper Audio Voice Transcription)
GROQ_API_KEY=
VITE_GROQ_API_KEY=

# HuggingFace Token (Optional Alternative Model Provider)
HF_TOKEN=
VITE_HF_TOKEN=

# Firebase Web API Key (Optional Database Persistence)
FIREBASE_API_KEY=

# Allowed CORS Origin (Optional)
CORS_ORIGIN=
